# .env.example — Phase 2 backend environment variables
# Copy this file to .env and fill in real values for your backend deployment.
# NEVER commit .env (with real values) to the repository.
# This .env.example file is safe to commit — it contains no real secrets.

# ── AI provider key ───────────────────────────────────────────────────────────
# The AI API key used by the secure backend proxy to call the AI model.
# Keep this on the server ONLY — never put this in frontend code.
AI_API_KEY=

# ── CORS / origin control ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Only requests from these origins will be accepted by the backend.
ALLOWED_ORIGINS=https://doctor0579.github.io

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum AI chat requests per IP per minute.
RATE_LIMIT_RPM=

# Maximum AI chat requests per session per day.
RATE_LIMIT_SESSION_RPD=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
# Server-side Turnstile secret key for verifying challenge tokens.
# Leave empty to disable bot protection (not recommended for production).
TURNSTILE_SECRET=

# ── Session signing ────────────────────────────────────────────────────────────
# HMAC secret for signing short-lived session tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Session token TTL in seconds (default: 3600 = 1 hour).
SESSION_TTL_SECONDS=3600

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── Deployment ────────────────────────────────────────────────────────────────
# Port for the backend server (if self-hosted).
PORT=3000

# Node environment: development | production
NODE_ENV=production
